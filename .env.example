# Copy to `.env` at this repository root. All apps (be / web / agent-layer) read from there.
# Never commit `.env`.

# =============================================================================
# Backend (NestJS `be/`)
# =============================================================================
PORT=8787
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

DATABASE_URL="file:./dev.db"

LOG_LEVEL=debug

MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# =============================================================================
# Frontend (Next.js `web/`) — server routes & tooling
# =============================================================================
# Server-side proxy to Nest (optional overrides)
# BE_BASE_URL=http://localhost:8787
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenRouter (recognize / pixel-art API routes when not using BE proxy)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_VISION_MODEL=moonshotai/kimi-k2.5
# OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-pro

# Next.js / SWC
# NEXT_USE_WASM_SWC=0

# =============================================================================
# Tencent Hunyuan 3D (`web` three-d-growth API)
# =============================================================================
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_REGION=ap-guangzhou

# =============================================================================
# Agent layer (vision + image generation) — used by `be` and `agent-layer` CLI
# Reference: agent-layer/src/providers/config.ts
# =============================================================================

# Vision: fake | claude | gemini | openai | openai-compatible
PLANT_AGENT_VISION_PROVIDER=fake
# PLANT_AGENT_VISION_TIMEOUT_MS=60000

# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# PLANT_AGENT_CLAUDE_MODEL=claude-opus-4-7

# GOOGLE_API_KEY=
# PLANT_AGENT_GEMINI_MODEL=gemini-2.5-flash

# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# PLANT_AGENT_OPENAI_MODEL=gpt-4.1

# PLANT_AGENT_OPENAI_COMPATIBLE_API_KEY=
# PLANT_AGENT_OPENAI_COMPATIBLE_BASE_URL=
# PLANT_AGENT_OPENAI_COMPATIBLE_MODEL=gpt-4.1

# Image generation: fake | openrouter
PLANT_AGENT_IMAGE_GENERATION_PROVIDER=fake
# PLANT_AGENT_IMAGE_GENERATION_TIMEOUT_MS=30000

# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=
# PLANT_AGENT_OPENROUTER_MODEL=google/gemini-3.1-flash-image-preview

# =============================================================================
# Optional: bobdong.cn smoke test (agent-layer/scripts/bobdong-smoke.ts)
# =============================================================================
# BOBDONG_OPENAI_CHAT_URL=https://bobdong.cn/v1/chat/completions
# BOBDONG_GEMINI_GENERATE_URL=https://bobdong.cn/v1beta/models/gemini-3-pro-image-preview:generateContent
# BOBDONG_API_KEY=

# =============================================================================
# Agent-layer manual HTTP console (npm run manual-console in agent-layer)
# =============================================================================
# PORT=3000
