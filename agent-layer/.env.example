# Copy to .env and fill values. Never commit .env.
# Reference: src/providers/config.ts

# -----------------------------------------------------------------------------
# Vision (analyze-profile, assess-state, and CLI commands that use vision)
# PLANT_AGENT_VISION_PROVIDER: fake | claude | gemini | openai | openai-compatible
# -----------------------------------------------------------------------------
PLANT_AGENT_VISION_PROVIDER=fake

# Optional: request timeout in milliseconds
# PLANT_AGENT_VISION_TIMEOUT_MS=60000

# --- Anthropic (when PLANT_AGENT_VISION_PROVIDER=claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# PLANT_AGENT_CLAUDE_MODEL=claude-opus-4-7

# --- Google Gemini (when PLANT_AGENT_VISION_PROVIDER=gemini) ---
GOOGLE_API_KEY=
# PLANT_AGENT_GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (when PLANT_AGENT_VISION_PROVIDER=openai) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# PLANT_AGENT_OPENAI_MODEL=gpt-4.1

# --- OpenAI-compatible gateway (when PLANT_AGENT_VISION_PROVIDER=openai-compatible) ---
# Example: third-party base URL exposing /v1/chat/completions
PLANT_AGENT_OPENAI_COMPATIBLE_API_KEY=
PLANT_AGENT_OPENAI_COMPATIBLE_BASE_URL=
# PLANT_AGENT_OPENAI_COMPATIBLE_MODEL=gpt-4.1

# -----------------------------------------------------------------------------
# Image generation (pixel-art CLI, generatePixelArt)
# PLANT_AGENT_IMAGE_GENERATION_PROVIDER: fake | openrouter
# -----------------------------------------------------------------------------
PLANT_AGENT_IMAGE_GENERATION_PROVIDER=fake

# Optional
# PLANT_AGENT_IMAGE_GENERATION_TIMEOUT_MS=30000

# --- OpenRouter (when PLANT_AGENT_IMAGE_GENERATION_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=
# PLANT_AGENT_OPENROUTER_MODEL=google/gemini-3.1-flash-image-preview

# -----------------------------------------------------------------------------
# Optional: bobdong.cn smoke test (scripts/bobdong-smoke.ts)
# Uses PLANT_AGENT_OPENAI_COMPATIBLE_API_KEY or BOBDONG_API_KEY
# -----------------------------------------------------------------------------
# BOBDONG_OPENAI_CHAT_URL=https://bobdong.cn/v1/chat/completions
# BOBDONG_GEMINI_GENERATE_URL=https://bobdong.cn/v1beta/models/gemini-3-pro-image-preview:generateContent
# BOBDONG_API_KEY=

# -----------------------------------------------------------------------------
# Local HTTP manual console (npm run manual-console)
# -----------------------------------------------------------------------------
# PORT=3000
